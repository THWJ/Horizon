{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-flash",
    "api_key_env": "DEEPSEEK_API_KEY",
    "base_url": "https://api.deepseek.com",
    "languages": ["en", "zh"],
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "xxx@qq.com",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "torvalds",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
            {
        "name": "36氪",
        "url": "https://www.36kr.com/feed",
        "category": "business",
        "fetch_limit": 15
      },
      {
        "name": "虎嗅",
        "url": "https://rss.huxiu.com/",
        "category": "business",
        "fetch_limit": 15
      },
      {
        "name": "钛媒体",
        "url": "https://www.tmtpost.com/feed",
        "category": "business",
        "fetch_limit": 15
      },
      {
        "name": "IT之家",
        "url": "https://www.ithome.com/rss/",
        "category": "tech",
        "fetch_limit": 20
      },
      {
        "name": "奇客Solidot",

{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.5,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 6.5,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 7.5,
        "topic_dedup": true
      },
      "ai-creator": {
        "threshold": 7.5,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "hackernews": {
        "enabled": false,
        "fetch_top_stories": 30,
        "min_score": 150,
        "profile": "tech-news"
    },
    "rss": [
      {
        "name": "arXiv AI",
        "url": "https://rss.arxiv.org/rss/cs.AI",
        "enabled": true,
        "category": "ai-research",
        "profile": "tech-news"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "ai-engineering",
        "profile": "tech-blog"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-engineering",
        "profile": "tech-blog"
      },
      {
        "name": "TechCrunch AI",
        "url": "https://techcrunch.com/category/artificial-intelligence/feed/",
        "enabled": true,
        "category": "ai-business",
        "profile": "ai-creator"
      },
      {
        "name": "US-China Relations",
        "url": "https://news.google.com/rss/search?q=%28US+China+relations%29+OR+%28US+China+trade%29&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "geopolitics",
        "profile": "tech-news"
      },
      {
        "name": "Global Geopolitics",
        "url": "https://news.google.com/rss/search?q=%28geopolitical+conflict%29+OR+%28energy+security%29+OR+%28global+supply+chain%29&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "geopolitics",
        "profile": "tech-news"
      },
      {
        "name": "US Macro and Fed",
        "url": "https://news.google.com/rss/search?q=%28Federal+Reserve%29+OR+%28US+inflation%29+OR+%28US+Treasury+yields%29&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "macro-finance",
        "profile": "finance-news"
      },
      {
        "name": "China Economy and Finance",
        "url": "https://news.google.com/rss/search?q=%28China+economy%29+OR+%28China+financial+markets%29+OR+%28People%27s+Bank+of+China%29&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "macro-finance",
        "profile": "finance-news"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": false,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "profile": ["tech-news", "finance-news"]
        }
      ]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": null,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
